// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?  @default("https://images.unsplash.com/photo-1549923746-c502d4883ea?w=128&auto=format&fit=crop&q=80") // <--- เพิ่มบรรทัดนี้
  email       String
  phone       String?
  location    String
  industry    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        Job[]

  @@map("companies")
}

model Job {
  id                 Int      @id @default(autoincrement())
  title              String
  description        String
  requirements       String
  benefits           String?
  jobType            String   // e.g. "INTERNSHIP", "FULL_TIME", "PART_TIME"
  workplaceType      String   // e.g. "ON_SITE", "HYBRID", "REMOTE"
  category           String   // e.g. "Software Engineering", "Data & AI", "Design", "Marketing", "Business"
  stipendMin         Float    @default(0)
  stipendMax         Float    @default(0)
  location           String   // สถานที่ตั้ง (เช่น กรุงเทพฯ, เชียงใหม่)
  region             String?  // เพิ่มฟิลด์เก็บชื่อภาค เช่น 'CENTRAL', 'NORTH', 'SOUTH'
  applicationDeadline DateTime
  status             String   @default("OPEN") // "OPEN", "CLOSED"
  contactEmail       String
  applyUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyId          Int
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STUDENT") // เช่น STUDENT หรือ EMPLOYER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}